{
  "name": "question-analyzer-server",
  "version": "1.0.0",
  "description": "AI-Powered Exam Question Analyzer - Backend API",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:workers\"",
    "dev:server": "nodemon index.js",
    "dev:workers": "concurrently \"npm run worker:extraction\" \"npm run worker:verification\"",
    "worker:extraction": "nodemon src/jobs/extractionWorker.js",
    "worker:verification": "nodemon src/jobs/verificationWorker.js",
    "start": "node index.js",
    "start:workers": "npm run worker:extraction & npm run worker:verification",
    "lint": "oxlint src/",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "db:init": "psql -U postgres -c \"CREATE DATABASE question_analyzer;\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.15.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "json2csv": "^5.0.7",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.4",
    "pdf2pic": "^3.2.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "tesseract.js": "^5.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
